{
  "name": "@arm0ne/alien-ai-studio-agent",
  "version": "0.1.0",
  "description": "Local Codex bridge for Alien AI Studio and img.panlai.me.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "alien-ai-studio-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "debug": "tsx src/index.ts --debug",
    "test": "tsx --test src/config.test.ts src/site-launch.test.ts src/canvas/operations.test.ts src/canvas/session.test.ts src/agent/codex-client.test.ts src/agent/codex-history.test.ts src/agent/message-metadata.test.ts src/skills/store.test.ts src/utils/agent-runtime.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openai/codex": "0.146.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "strip-ansi": "7.2.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arm0ne/AI-image.git",
    "directory": "canvas-agent"
  },
  "homepage": "https://img.panlai.me",
  "bugs": {
    "url": "https://github.com/Arm0ne/AI-image/issues"
  },
  "keywords": [
    "codex",
    "mcp",
    "multimodal-generation",
    "canvas",
    "alien-ai-studio"
  ],
  "publishConfig": {
    "access": "public"
  }
}
